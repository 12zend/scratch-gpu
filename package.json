{
  "name": "scratch-gpu",
  "version": "1.0.0",
  "description": "Scratch GPU shader compiler — drop an .sb3 and watch pixel() run on the GPU.",
  "main": "electron/main.js",
  "types": "./types.d.ts",
  "scripts": {
    "build": "webpack",
    "prepublishOnly": "cross-env NODE_ENV=production webpack",
    "start": "electron electron/main.js",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.scratchgpu.app",
    "productName": "ScratchGPU",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/scaffolding-min.js",
      "dist/scaffolding-min.js.map",
      "dist/extension worker.js",
      "dist/extension worker.js.map",
      "dist/*.worker.js",
      "dist/*.worker.js.map"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "electron/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "electron/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TurboWarp/scaffolding.git"
  },
  "author": "Thomas Weber",
  "license": "MPL-2.0",
  "homepage": "https://github.com/TurboWarp/scaffolding",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@turbowarp/jszip": "^3.12.0",
    "@turbowarp/scratch-storage": "^2.0.0",
    "@turbowarp/scratch-svg-renderer": "^1.1.0",
    "babel-loader": "^8.3.0",
    "cross-env": "^7.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "scratch-audio": "github:TurboWarp/scratch-audio#develop",
    "scratch-render": "github:TurboWarp/scratch-render#develop",
    "scratch-vm": "github:TurboWarp/scratch-vm#develop",
    "webpack": "^4.47.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "@turbowarp/types": "github:TurboWarp/types-tw#tw"
  }
}
